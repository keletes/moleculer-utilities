{
	"name": "moleculer-utilities",
	"version": "0.5.2",
	"scripts": {
		"build": "rm -rf mixins middlewares stores utils && tsc --project tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . --ext .ts,.js",
		"test": "yarn build && jest --coverage",
		"verify": "yarn typecheck && yarn lint && yarn test"
	},
	"repository": "git@github.com:keletes/moleculer-utilities.git",
	"author": "Keletes <it@keletes.com>",
	"license": "MIT",
	"devDependencies": {
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/exec": "^6.0.3",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.9",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@types/jest": "^29.2.4",
		"@types/lodash.defaultsdeep": "^4.6.7",
		"@types/lodash.forin": "^4.4.9",
		"@types/lodash.isarray": "^4.0.9",
		"@types/lodash.isequal": "^4.5.8",
		"@types/lodash.isobject": "^3.0.9",
		"@types/lodash.isstring": "^4.0.7",
		"@types/node": "^22.0.0",
		"@types/object-hash": "^3.0.6",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"eslint": "^8.30.0",
		"jest": "^29.3.1",
		"moleculer": "^0.14.32",
		"moleculer-web": "^0.10.5",
		"redis": "^5.8.2",
		"semantic-release": "^25.0.9",
		"ts-jest": "^29.0.3",
		"typescript": "^5.0.0"
	},
	"dependencies": {
		"lodash.defaultsdeep": "^4.6.1",
		"lodash.forin": "^4.4.0",
		"lodash.isarray": "^4.0.0",
		"lodash.isequal": "^4.5.0",
		"lodash.isobject": "^3.0.2",
		"lodash.isstring": "^4.0.1",
		"object-hash": "^3.0.0"
	},
	"peerDependencies": {
		"moleculer": ">=0.14.0"
	},
	"description": "Shared Moleculer mixins, middlewares and rate-limit stores for the Keletes services",
	"keywords": [
		"moleculer",
		"mixin",
		"middleware",
		"rate-limit"
	],
	"engines": {
		"node": ">= 22.x.x"
	},
	"jest": {
		"coverageDirectory": "<rootDir>/coverage",
		"collectCoverageFrom": [
			"src/**/*.ts"
		],
		"testEnvironment": "node",
		"moduleFileExtensions": [
			"ts",
			"js"
		],
		"transform": {
			"^.+\\.ts$": "ts-jest"
		},
		"testMatch": [
			"**/*.spec.ts"
		],
		"testTimeout": 30000
	}
}
