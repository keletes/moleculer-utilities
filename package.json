{
	"name": "@keletes/moleculer-utilities",
	"version": "0.0.0-development",
	"files": [
		"mixins",
		"middlewares",
		"limits",
		"utils"
	],
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"build": "rm -rf mixins middlewares limits utils && tsc --project tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . --ext .ts,.js",
		"test": "yarn build && jest --coverage",
		"verify": "yarn typecheck && yarn lint && yarn test",
		"verify:int": "yarn build && jest --testMatch '**/*.int.ts' --coverage=false"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/keletes/moleculer-utilities.git"
	},
	"author": "Keletes <it@keletes.com>",
	"license": "MIT",
	"devDependencies": {
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/exec": "^6.0.3",
		"@semantic-release/github": "^12.0.9",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@types/jest": "^29.2.4",
		"@types/lodash.defaultsdeep": "^4.6.7",
		"@types/lodash.isstring": "^4.0.7",
		"@types/node": "^22.0.0",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"eslint": "^8.30.0",
		"ioredis": "^6.0.0",
		"jest": "^29.3.1",
		"moleculer": "^0.14.32",
		"moleculer-db": "^0.9.0",
		"moleculer-web": "^0.10.5",
		"semantic-release": "^25.0.9",
		"ts-jest": "^29.0.3",
		"typescript": "^5.0.0"
	},
	"dependencies": {
		"lodash.defaultsdeep": "^4.6.1",
		"lodash.isstring": "^4.0.1"
	},
	"peerDependencies": {
		"ioredis": ">=5.0.0",
		"moleculer": ">=0.14.0",
		"moleculer-db": ">=0.8.0"
	},
	"description": "Shared Moleculer mixins, middlewares and request limits for the Keletes services",
	"keywords": [
		"moleculer",
		"mixin",
		"middleware",
		"rate-limit",
		"limits"
	],
	"engines": {
		"node": ">= 22.x.x"
	},
	"jest": {
		"coverageDirectory": "<rootDir>/coverage",
		"collectCoverageFrom": [
			"src/**/*.ts"
		],
		"testEnvironment": "node",
		"moduleFileExtensions": [
			"ts",
			"js"
		],
		"transform": {
			"^.+\\.ts$": "ts-jest"
		},
		"testMatch": [
			"**/*.spec.ts"
		],
		"testTimeout": 30000
	},
	"peerDependenciesMeta": {
		"moleculer-db": {
			"optional": true
		},
		"ioredis": {
			"optional": true
		}
	}
}
